{
  "info": {
    "_postman_id": "15195e55-9bd9-45f8-8b09-3a14dbd2e153",
    "name": "NexusMarket API - Complete Collection",
    "description": "Complete end-to-end Postman Collection for NexusMarket API (Hexagonal Architecture + DDD in Spring Boot 4.1.0). Covers all 10 controllers and 29 endpoints across Auth, Users, Sellers, Warehouses, Products & Catalog, Inventory, Buyers, Cart, Orders, and Audit, with automatic JWT variable chaining and pm.test assertions.",
    "schema": "https://schema.postman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. Auth (/api/auth)",
      "description": "Authentication endpoints (/api/auth). Run 1.1 first after starting the app to obtain adminToken, and run 1.2-1.5 after registering/onboarding the respective users.",
      "item": [
        {
          "name": "1.1 Login as Admin (Seeded Bootstrap)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "if (json && json.data && json.data.token) { pm.environment.set(\"adminToken\", json.data.token); pm.collectionVariables.set(\"adminToken\", json.data.token); }",
                  "pm.test(\"JWT token returned\", function () { pm.expect(json.data.token).to.be.a(\"string\").and.not.empty; });"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login" }
          }
        },
        {
          "name": "1.2 Login as Seller",
