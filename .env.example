# ============================================================================
# NexusMarket API - Variables de Entorno (.env.example)
# Copia este archivo como .env o exporta estas variables en tu sistema/IDE
# ============================================================================

# --- Servidor HTTP ---
SPRING_APPLICATION_NAME=market_place
SERVER_PORT=8080

# --- Base de Datos Relacional (MySQL 8+) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=market_place_db
MYSQL_URL=jdbc:mysql://localhost:3306/market_place_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQL_USER=root
MYSQL_PASSWORD=0000

# --- Configuración JPA / Hibernate ---
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# --- Base de Datos Documental (MongoDB - Auditoría AuditLog) ---
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=market_place_audit_db
MONGODB_URI=mongodb://localhost:27017/market_place_audit_db

# --- Seguridad JWT (HS256 - mínimo 32 caracteres / 256 bits) ---
JWT_SECRET=MarketPlaceSuperSecretKeyForJWTSignature2024Minimum256BitsRequired!
JWT_EXPIRATION_MS=86400000

# --- Reglas de Negocio, Simulación de Pagos y Scheduler ---
# Probabilidad de aprobación de pago entre 0.0 (siempre rechaza) y 1.0 (siempre aprueba)
PAYMENT_APPROVAL_PROBABILITY=0.7
# Minutos antes de que una orden en PENDING_PAYMENT expire y libere su reserva de inventario
ORDER_UNPAID_EXPIRATION_MINUTES=30
# Intervalo de ejecución del scheduler de expiración de órdenes en milisegundos
ORDER_EXPIRATION_SCHEDULER_DELAY_MS=60000

# --- Semilla Inicial de Datos (DataSeeder - Usuario ADMIN por defecto) ---
SEED_ENABLED=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_IDENTIFICATION=ADMIN-001
SEED_ADMIN_EMAIL=admin@nexusmarket.com
SEED_ADMIN_FULL_NAME=System Administrator

# --- Configuración SMTP (Opcional - EmailNotificationAdapter usa log si no hay SMTP activo) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
